{
  "schema_version": "harness-config.v1",
  "pipeline": {
    "diagnose": "member2.drift:DriftDiagnoser",
    "decide": "member3.decider:LLMDecider",
    "train_candidate": "member4.trainer:CandidateTrainer",
    "evaluate_and_commit": "member5.evaluator:EvaluationGate"
  },
  "evaluator": "official",
  "predictor": "official",
  "gate": {
    "metric_name": "macro_f1",
    "direction": "maximize",
    "min_delta": 0.001,
    "max_regression": 0.02,
    "min_samples": 2
  },
  "budget": {
    "cpu_seconds": 3600,
    "tokens": 120000,
    "label_quota": null,
    "max_stages": 60,
    "max_candidates_per_stage": 2
  }
}
